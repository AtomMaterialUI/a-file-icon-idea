---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import IconGallery from "../components/icons/IconGallery/IconGallery.tsx";
import { getAllIcons } from "../lib/icons";

const title = "Icons Reference";
const description = "Browse and search through all available icons in the Atom Material Icons plugin.";

const icons = await getAllIcons();
---

<StarlightPage frontmatter={{ title, description, tableOfContents: false }}>
  <div class="content">
    <AnchorHeading level="1" id="title">🎨 Icon Gallery</AnchorHeading>
    <p class="subtitle">
      Browse and search through all {icons.counts.all} available icons
    </p>

    <IconGallery client:visible icons={icons.all} counts={icons.counts} />
  </div>
</StarlightPage>
