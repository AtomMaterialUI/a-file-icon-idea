---
import vscodeIcon from '../assets/icons/vscode.svg?url';
import chromeIcon from '../assets/icons/chrome.svg?url';
import firefoxIcon from '../assets/icons/firefox.svg?url';
import edgeIcon from '../assets/icons/edge.svg?url';

interface Plugin {
  name: string;
  url: string;
  icon: string;
}

const plugins: Plugin[] = [
  {
    name: 'VS Code Extension',
    url: 'https://marketplace.visualstudio.com/items?itemName=AtomMaterial.a-file-icon-vscode',
    icon: vscodeIcon,
  },
  {
    name: 'Chrome Extension',
    url: 'https://chromewebstore.google.com/detail/atom-material-icons/pljfkbaipkidhmaljaaakibigbcmmpnc?hl=en',
    icon: chromeIcon,
  },
  {
    name: 'Firefox Extension',
    url: 'https://addons.mozilla.org/en-US/firefox/addon/atom-file-icons-web/',
    icon: firefoxIcon,
  },
  {
    name: 'Edge Extension',
    url: 'https://microsoftedge.microsoft.com/addons/detail/atom-material-icons/ajfcnjlggplaibcmaannbijmblhiiiee',
    icon: edgeIcon,
  },
];
---

<section>
  <h3 class="section-title">Also Available For:</h3>

  <div class="packages-list">
    {plugins.map(plugin => (
      <a href={plugin.url} target="_blank" rel="noopener noreferrer"
         title={plugin.name} class="package-item">
        <img src={plugin.icon} alt={plugin.name} />
      </a>
    ))}
  </div>
</section>
